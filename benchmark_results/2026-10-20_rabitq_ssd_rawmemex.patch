@@ -266,6 +270,11 @@ int main(int argc, char **argv)
         std::cout << "SSD store: raw (" << rabitqlib::elem_type_name(data_elem)
                   << " records; total_bits is ignored)\n";
     }
+    else if (ssd_store == SsdStore::RawMemEx)
+    {
+        std::cout << "SSD store: rawmemex (" << rabitqlib::elem_type_name(data_elem)
+                  << " records; total_bits=" << total_bits << " codes in RAM)\n";
+    }
     else
     {
         std::cout << "SSD store: exbits (total_bits=" << total_bits << ")\n";
@@ -395,9 +404,9 @@ int main(int argc, char **argv)
                              (ssd_store == SsdStore::Raw) ? 1 : total_bits,
