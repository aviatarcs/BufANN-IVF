         log_ssd_layout();
     }
@@ -668,7 +674,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         uint32_t elem_u = 0;
         input.read(reinterpret_cast<char *>(&store_u), sizeof(uint32_t));
         input.read(reinterpret_cast<char *>(&elem_u), sizeof(uint32_t));
-        if (!input || store_u > static_cast<uint32_t>(SsdStore::Raw) ||
+        if (!input || store_u > static_cast<uint32_t>(SsdStore::RawMemEx) ||
             elem_u > static_cast<uint32_t>(VecElemType::U8))
         {
             LOG(ERROR) << "Base index has an unknown SSD store (" << store_u
@@ -683,6 +689,12 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                        << ex_bits_ << ": " << base_index_file;
             std::exit(1);
         }
+        if (ssd_store_ == SsdStore::RawMemEx && ex_bits_ == 0)
+        {
+            LOG(ERROR) << "Base index claims RAM-resident ex-codes but ex_bits=0: "
+                       << base_index_file;
+            std::exit(1);
+        }
     }
 
     template <class PendingSet>
@@ -793,7 +805,13 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         // the part of that code that is not memory-resident. The Raw store
         // simply does not write it: its record is the vector itself.
         ssd_dim_ = padded_dim_ - mem_dim_;
-        if (ssd_store_ == SsdStore::Raw)
+        if (mem_ex() && ssd_dim_ != 0)
+        {
+            LOG(ERROR) << "store=rawmemex needs MEMDIM = padded_dim (" << padded_dim_
+                       << "): its B-bit estimate uses the whole 1-bit code";
+            std::exit(1);
+        }
+        if (raw_records())
         {
             empty_ssd_ = false;
         }
@@ -805,7 +823,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         LOG(INFO) << "mem_dim_ = " << mem_dim_ << "    ssd_dim_ = " << ssd_dim_;
         LOG(INFO) << "empty_ssd_=" << empty_ssd_;
 
-        if (ssd_store_ == SsdStore::Raw)
+        if (raw_records())
         {
             // The input vector, zero-padded to padded_dim.
             one_data_ssd_bytes_ = padded_dim_ * elem_type_bytes(raw_elem_);
@@ -851,6 +869,11 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         mem_batch_data_ = memory::align_allocate<64, char, true>(
             mem_batch_data_bytes(cluster_sizes));
         ids_ = memory::align_allocate<64, PID, true>(ids_bytes());
+        if (mem_ex())
+        {
+            mem_ex_data_ = memory::align_allocate<64, char, true>(
+                num_ * ExDataMap<float>::data_bytes(padded_dim_, ex_bits_));
+        }
         ip_func_ = select_excode_ipfunc(ex_bits_);
     }
 
@@ -997,6 +1020,15 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                 ssd_bin_data_ptr, ex_data_ptr, metric_type_, config);
         }
 
+        if (mem_ex())
+        {
+            // ex_data_tmp is in stored order, as cp.ids(), whose offset in
+            // ids_ is this cluster's first position in mem_ex_data_.
+            const size_t first = static_cast<size_t>(cp.ids() - ids_);
+            std::memcpy(mem_ex_data_ + first * ex_bytes_per_point, ex_data_tmp,
+                        num_points * ex_bytes_per_point);
+        }
+
         if (one_data_ssd_bytes_ == 0)
         {
             std::free(ssd_bin_data_tmp);
@@ -1045,7 +1077,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                 char *buf_ptr = page_buf + q * write_len;
                 for (size_t i = 0; i < points_in_page; ++i)
                 {
-                    if (ssd_store_ == SsdStore::Raw)
+                    if (raw_records())
                     {
                         // fetch_row(k) is the k-th point in stored order, the
                         // same order as cp.ids(), before any rotation.
@@ -1985,6 +2017,12 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                      static_cast<long>(mem_batch_data_bytes(cluster_sizes)));
         output.write(reinterpret_cast<const char *>(ids_),
                      static_cast<long>(ids_bytes()));
+        if (mem_ex())
+        {
+            output.write(mem_ex_data_,
+                         static_cast<long>(num_ * ExDataMap<float>::data_bytes(
+                                                      padded_dim_, ex_bits_)));
+        }
         output.close();
     }
 
@@ -2216,6 +2254,12 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                                         mem_batch_data_bytes(cluster_sizes)));
         input.read(reinterpret_cast<char *>(ids_),
                    static_cast<std::streamsize>(ids_bytes()));
+        if (mem_ex())
+        {
+            input.read(mem_ex_data_,
+                       static_cast<std::streamsize>(
+                           num_ * ExDataMap<float>::data_bytes(padded_dim_, ex_bits_)));
+        }
         if (!input)
         {
             LOG(ERROR) << "Failed to read base index payload (MEMDIM="
@@ -2341,7 +2385,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         buf.rotated_query =
             memory::align_allocate<64, float, true>(padded_dim_ * sizeof(float));
         buf.raw_query =
-            (ssd_store_ == SsdStore::Raw)
+            raw_records()
                 ? memory::align_allocate<64, float, true>(padded_dim_ * sizeof(float))
                 : nullptr;
         buf.request_slot_bytes = page_num_per_io_ * SECTOR_LEN;
@@ -2520,6 +2564,30 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                 continue;
             }
 
+            float low = query_buf->low_distance[idx];
+            float est = query_buf->est_distance[idx];
+            if (mem_ex())
+            {
+                // B-bit refinement from RAM, before any page is read. The
+                // 1-bit error term is est - low = f_error * g_error; the
+                // B-bit estimate's is that over 2^(B-1) (split_single_fulldist).
+                const size_t pos = static_cast<size_t>(state.ids - ids_) +
+                                   static_cast<size_t>(state.cur_inner_pid);
+                const char *ex_ptr =
+                    mem_ex_data_ + pos * ExDataMap<float>::data_bytes(padded_dim_, ex_bits_);
+                const float est_b = split_distance_boosting(
+                    ex_ptr, ip_func_, q_obj, probe_idx, padded_dim_, ex_bits_,
+                    query_buf->ip_x0_qr[idx]);
+                const float low_b =
+                    est_b - (est - low) / static_cast<float>(1U << ex_bits_);
+                if (low_b > distk)
+                {
+                    continue;
+                }
+                low = std::max(low, low_b);
+                est = est_b;
+            }
+
             const size_t prefetch_pid =
                 static_cast<size_t>(state.cur_inner_pid + 32);
             if (prefetch_pid < cur_cluster.num())
@@ -2546,7 +2614,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
                 page_cand.probe_idx = static_cast<CID>(probe_idx);
                 page_cand.page_id = cur_page_id;
                 page_cand.candidate_num = 0;
-                page_cand.page_lower_bound = query_buf->low_distance[idx];
+                page_cand.page_lower_bound = low;
             }
 
             PageCandidates &page_cand =
@@ -2558,11 +2626,10 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
             ++state.scan_cand_inserted_local;
             cand.true_data_id = true_data_id;
             cand.in_page_idx = cur_in_page_idx;
-            cand.mem_low_dist_ = query_buf->low_distance[idx];
-            cand.mem_est_dist_ = query_buf->est_distance[idx];
+            cand.mem_low_dist_ = low;
+            cand.mem_est_dist_ = est;
             cand.mem_ip_x0_qr_ = query_buf->ip_x0_qr[idx];
-            page_cand.page_lower_bound = std::min(
-                page_cand.page_lower_bound, query_buf->low_distance[idx]);
+            page_cand.page_lower_bound = std::min(page_cand.page_lower_bound, low);
         }
 
         if (iter + 1 < n_iter)
@@ -2612,7 +2679,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         void *ctx = file_reader_->get_ctx();
 
         rotator_->rotate(query, query_buf->rotated_query);
-        if (ssd_store_ == SsdStore::Raw)
+        if (raw_records())
         {
             // Raw records are compared with the query as given.
             std::memcpy(query_buf->raw_query, query, dim_ * sizeof(float));
@@ -2948,7 +3015,7 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         // submission upstream.
         float distk = knns.top_dist();
 
-        if (ssd_store_ == SsdStore::Raw)
+        if (raw_records())
         {
             // Raw records: the exact distance to the unrotated query, on the
             // scale the in-memory estimator uses (squared L2, or 1 - <q, o>
diff --git a/scripts/_params.sh b/scripts/_params.sh
index 2c7c4c1..809886c 100644
--- a/scripts/_params.sh
+++ b/scripts/_params.sh
@@ -96,7 +96,14 @@ derive_params() {
                 return 1
             fi
             STORE_TAG=raw ;;
-        *) echo "[FATAL] STORE_ENV must be exbits or raw, got '${STORE}'" >&2; return 1 ;;
+        rawmemex)
+            # Raw records on SSD plus a B-bit code in RAM; B is set explicitly.
+            if [[ -z "${B_ENV:-}" ]]; then
+                echo "[FATAL] STORE_ENV=rawmemex needs B_ENV (bits per dimension kept in RAM, 2-9)" >&2
+                return 1
+            fi
+            STORE_TAG=rawmemexB${B} ;;
+        *) echo "[FATAL] STORE_ENV must be exbits, raw or rawmemex, got '${STORE}'" >&2; return 1 ;;
     esac
     case ${METRIC} in
         l2|ip) ;;
diff --git a/scripts/build_index/_build_lib.sh b/scripts/build_index/_build_lib.sh
index 07e172a..6e448c4 100644
--- a/scripts/build_index/_build_lib.sh
+++ b/scripts/build_index/_build_lib.sh
@@ -91,6 +91,7 @@ build_index() {
 
