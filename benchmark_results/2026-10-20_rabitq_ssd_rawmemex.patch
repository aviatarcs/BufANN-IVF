     {
-        ivf_ssd_index.set_ssd_store(SsdStore::Raw, data_elem);
+        ivf_ssd_index.set_ssd_store(ssd_store, data_elem);
     }
     if (!streaming)
     {
diff --git a/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.hpp b/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.hpp
index 5963cd6..51c218a 100644
--- a/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.hpp
+++ b/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.hpp
@@ -61,10 +61,17 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
     //             exact distance to the unrotated query. The in-memory prefix
     //             and its bounds are the same as for ExBits, so the scan,
     //             pruning and I/O pipeline are shared unchanged.
+    //   RawMemEx -> Raw records on SSD, plus the extra-precision code
+    //             (B-1 bits per dimension) kept in RAM next to the 1-bit code.
+    //             The scan refines each candidate that passes the 1-bit bound
+    //             with the B-bit estimate and its bound, f_error * g_error /
+    //             2^(B-1) (as split_single_fulldist), before any page is read;
+    //             re-ranking is exact, as for Raw. Requires MEMDIM = padded_dim.
     enum class SsdStore : uint8_t
     {
         ExBits = 0,
         Raw = 1,
+        RawMemEx = 2,
     };
 
     // Cluster scan is batched: for each 32-point batch the scan refreshes
@@ -482,6 +489,15 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         ivf::Initializer *initer_ = nullptr;
         char *mem_batch_data_ = nullptr;
         PID *ids_ = nullptr;
+        // RawMemEx only: num_ ExDataMap records (ex-code + 2 factors), in the
+        // same stored order as ids_.
+        char *mem_ex_data_ = nullptr;
+        // SSD records are the vectors themselves (Raw or RawMemEx).
+        [[nodiscard]] bool raw_records() const
+        {
+            return ssd_store_ == SsdStore::Raw || ssd_store_ == SsdStore::RawMemEx;
+        }
+        [[nodiscard]] bool mem_ex() const { return ssd_store_ == SsdStore::RawMemEx; }
         size_t num_ = 0;
         size_t dim_ = 0;
         size_t padded_dim_ = 0;
@@ -551,6 +567,8 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
             mem_batch_data_ = nullptr;
             std::free(ids_);
             ids_ = nullptr;
+            std::free(mem_ex_data_);
+            mem_ex_data_ = nullptr;
         }
 
         std::shared_ptr<LinuxAlignedFileReader> file_reader_;
@@ -840,7 +858,9 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
         // "exbits" or "raw", the spelling build_invlist's store= option takes.
         [[nodiscard]] const char *ssd_store_name() const
         {
-            return ssd_store_ == SsdStore::Raw ? "raw" : "exbits";
+            return ssd_store_ == SsdStore::Raw        ? "raw"
+                   : ssd_store_ == SsdStore::RawMemEx ? "rawmemex"
+                                                      : "exbits";
         }
         // One line for logs, e.g. "exbits (B=9)" or "raw (uint8 records)".
         [[nodiscard]] std::string ssd_store_description() const
@@ -849,6 +869,11 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
             {
                 return std::string("raw (") + elem_type_name(raw_elem_) + " records)";
             }
+            if (ssd_store_ == SsdStore::RawMemEx)
+            {
+                return std::string("rawmemex (") + elem_type_name(raw_elem_) +
+                       " records, B=" + std::to_string(ex_bits_ + 1) + " codes in RAM)";
+            }
             return "exbits (B=" + std::to_string(ex_bits_ + 1) + ")";
         }
 
diff --git a/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.tpp b/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.tpp
index 2e45267..119beb5 100644
--- a/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.tpp
+++ b/rabitqlib/index/ivf/ivf_ssd_boundary_qd_ms_common.tpp
@@ -592,6 +592,12 @@ namespace rabitqlib::ivf_ssd_boundary_qd_ms_detail
             // the extra-precision code, so no ex-code is computed or stored.
             ex_bits_ = 0;
         }
+        if (store == SsdStore::RawMemEx && ex_bits_ == 0)
+        {
+            LOG(ERROR) << "store=rawmemex needs total_bits >= 2: the RAM-resident "
