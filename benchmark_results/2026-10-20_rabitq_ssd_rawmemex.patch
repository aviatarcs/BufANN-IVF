     [[ ${STORE} == raw ]] && STORE_DESC="store=raw"
+    [[ ${STORE} == rawmemex ]] && STORE_DESC="store=rawmemex(B=${B})"
     echo "================ build ${DATASET} C=${C} ${STORE_DESC%% *} memdim=${MEMDIM} metric=${METRIC} coarse=${COARSE_KIND} ================"
     echo "  start  : $(date -Is)"
     echo "  outdir : ${OUTDIR}"
